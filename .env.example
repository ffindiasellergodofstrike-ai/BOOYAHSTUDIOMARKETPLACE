# Public canonical origin only. Never prefix server secrets with VITE_.
VITE_SITE_URL=https://your-marketplace-domain.example
# RAZORPAY_KEY_ID is returned to checkout; SUPABASE_ANON_KEY is used by server Auth.
# SERVER CONFIGURATION: set in Vercel Project Settings > Environment Variables.
# No server secret may use a VITE_ prefix. Apply in Vercel and redeploy.
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
# Replace with an address on your verified sending domain (not an unverified Gmail sender).
RESEND_FROM_EMAIL=

# Gateway defaults are OFF until enabled in Admin > Marketplace > Gateways.
# Keep sandbox and production credentials separate.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
# Optional signed Resend delivery/bounce webhook verification secret.
RESEND_WEBHOOK_SECRET=
# Protects /api/jobs/reconcile. A daily Vercel fallback is declared.
# For prompt retries, configure a 5-minute authenticated external/Pro scheduler; verify actual last-run.
CRON_SECRET=

# Private creator KYC encryption: generate once with openssl rand -base64 32.
# Store securely; changing without migration makes existing encrypted fields unreadable.
MARKETPLACE_ENCRYPTION_KEY=

# Provider activation flags: set true only after written provider activation.
CASHFREE_EASYSPLIT_APPROVED=false
RAZORPAY_ROUTE_APPROVED=false
EASEBUZZ_MARKETPLACE_APPROVED=false
CASHFREE_SUBSCRIPTIONS_APPROVED=false
RAZORPAY_SUBSCRIPTIONS_APPROVED=false

# Easebuzz server-only credentials and environment.
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test
# Provider-issued label registry installed after Easebuzz approves the sellers.
EASEBUZZ_APPROVED_SPLIT_LABELS_JSON={}
