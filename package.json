{
  "name": "@workspace/booyah-studio-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsx scripts/generate-product-pages.ts && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.mjs && esbuild server/app.ts --bundle --platform=node --format=esm --packages=external --outfile=build/api-app.mjs && node scripts/check-vercel-runtime.mjs",
    "start": "NODE_ENV=production node build/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts src/services/*.test.ts",
    "check:vercel": "node scripts/check-vercel-runtime.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.38",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "megajs": "1.3.10",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "resend": "^6.28.1",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
